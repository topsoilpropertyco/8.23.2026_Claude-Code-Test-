node_modules/
.env
*.log

# Build artifact: regenerated by web/build.js and embeds real journal text.
web/dashboard.html

# Built from real biometrics; never committed to a public repo.
web/night.html

# Rendered from real biometrics; never committed.
web/night.png

# Phase 4 bake-off sheet: generated by bin/build-bakeoff.py, 6.3MB of embedded
# screenshots. Rebuild it rather than committing it. shots/ is its input.
web/phase4-bakeoff.html
shots/

# Phase 5 screens: generated by bin/build-screens.py + bin/build-gallery.py.
web/phase5-screens.html

# Deck build: generated by bin/build-deck.py from the variants.
web/deck.html

# Generated per-run from real telemetry; a sample must never be committed as a night.
data/last-night.json

# The encrypted dashboard, rebuilt every run and delivered to Pages as an
# artifact rather than through the repository. Ciphertext, but there is no reason
# to churn 0.12 MB of it into history every five minutes.
site/
